# Copy to /etc/wwtextile/env (chmod 600) for production. Never commit the real file.
WW_ENV=production
WW_SECRET_KEY=            # REQUIRED in production: python3 -c "import secrets;print(secrets.token_hex(32))"
WW_COOKIE_SECURE=1        # keep 1; serve only over HTTPS
WW_DB_PATH=/var/lib/wwtextile/wwtextile.db
WW_UPLOAD_DIR=/var/lib/wwtextile/uploads
WW_SESSION_HOURS=12
WW_DISPLAY_TZ=Asia/Karachi
WW_CURRENCY=PKR
WW_FORWARDED_ALLOW_IPS=127.0.0.1   # address of your reverse proxy
WW_TRANSCRIPT_RETENTION_DAYS=30
# Demo only (WW_ENV=demo): WW_DEMO_PASSWORD=...
# Optional AI / voice. Everything works without them (rule-based assistant, browser speech).
# WW_AI_PROVIDER=anthropic|openai   WW_AI_API_KEY=   WW_AI_MODEL=   WW_AI_BASE_URL=
# WW_STT_PROVIDER=openai WW_STT_API_KEY= WW_STT_MODEL=whisper-1 WW_STT_BASE_URL=
# WW_TTS_PROVIDER=openai WW_TTS_API_KEY= WW_TTS_MODEL=tts-1 WW_TTS_VOICE=alloy WW_TTS_BASE_URL=
